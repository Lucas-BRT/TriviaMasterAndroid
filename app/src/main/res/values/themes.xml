<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.TriviaMasterAndroid" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/blue</item>
        <item name="colorPrimaryVariant">@color/blue_dark</item>
        <item name="colorSecondary">@color/sun</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_soft</item>
        <item name="android:windowAnimationStyle">@style/Animation.Trivia</item>
    </style>

    <style name="Animation.Trivia" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/screen_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/screen_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/screen_pop_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/screen_pop_exit</item>
    </style>

    <style name="Text.Display" parent="">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">52sp</item>
        <item name="android:lineSpacingMultiplier">0.92</item>
    </style>

    <style name="Text.Title" parent="">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="Text.Body" parent="">
        <item name="android:textColor">@color/ink_soft</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="Text.Label" parent="">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Button.Primary" parent="">
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">60dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Button.Secondary" parent="">
        <item name="android:background">@drawable/bg_btn_secondary</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
